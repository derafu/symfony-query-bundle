{
    "name": "derafu/symfony-query-bundle",
    "description": "Derafu: Symfony Query Bundle - Integrates derafu/query with Symfony.",
    "type": "symfony-bundle",
    "homepage": "https://www.derafu.dev/docs/symfony/query-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/symfony-query-bundle/issues",
        "source": "https://github.com/derafu/symfony-query-bundle"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\QueryBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsQueryBundle\\": "tests/src/",
            "Derafu\\TestsQueryBundle\\Fixture\\": "tests/fixtures/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/array": "dev-main",
        "derafu/query": "dev-main",
        "doctrine/orm": "^3.7",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "doctrine/doctrine-bundle": "^3.3",
        "derafu/symfony-translation-bundle": "dev-main",
        "ext-pdo_sqlite": "*",
        "api-platform/core": "^4.4"
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "api-platform/core": "Registers SmartFilter for API Platform Doctrine ORM collection filtering when installed."
    }
}
